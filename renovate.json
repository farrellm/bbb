{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "groupName": "dev tools",
      "matchFileNames": ["Makefile", "lefthook.yml"]
    },
    {
      "groupName": "github actions",
      "matchManagers": ["github-actions"]
    },
    {
      "groupName": "frontend dev tools",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions annotated with # renovate: comments",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+\\s*:=\\s*(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "sqlfluff in the git hooks",
      "managerFilePatterns": ["/^lefthook\\.yml$/"],
      "matchStrings": ["sqlfluff==(?<currentValue>[\\d.]+)"],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "sqlfluff"
    }
  ]
}
