{
  "name": "bbb-watch-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:api": "npm ci --prefix tools/gen-api --silent && tools/gen-api/node_modules/.bin/openapi-typescript ../backend/api/openapi.yaml -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "lint": "oxlint --type-aware --deny-warnings && tsc -b && knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "knip": "6.41.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
