{
  // src/lib/wordDiff.ts is copied byte for byte from nisaba, which doesn't
  // build with noUncheckedIndexedAccess or exactOptionalPropertyTypes. It
  // gets its own project with nisaba's settings; the app project imports
  // its declaration output instead of rechecking the source.
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/worddiff",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worddiff.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "files": ["src/lib/wordDiff.ts"]
}
