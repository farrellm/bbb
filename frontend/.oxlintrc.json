{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "jsx-a11y",
    "import",
    "vitest",
    "oxc",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["dist", "src/api/schema.d.ts", "tools"],
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/strict-boolean-expressions": "warn",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "import/no-cycle": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    // The React Compiler ports of exhaustive-deps call a function from
    // context "unnecessary" while exhaustive-deps requires it; keep the
    // one that agrees with React's docs.
    "react/exhaustive-effect-dependencies": "off",
    "react/memo-dependencies": "off",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true
      }
    ],
    "react/purity": "error",
    "react/immutability": "error",
    "react/refs": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/globals": "error",
    "react/use-memo": "error",
    "react/preserve-manual-memoization": "error",
    "react/error-boundaries": "error",
    "react/unsupported-syntax": "error",
    "react/incompatible-library": "warn",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "typescript/consistent-return": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "react/no-array-index-key": "off"
  },
  "overrides": [
    {
      "files": ["src/sw.ts"],
      "env": { "serviceworker": true, "browser": false },
      "rules": {
        // workbox-build replaces this name with the precache list.
        "no-underscore-dangle": ["error", { "allow": ["__WB_MANIFEST"] }]
      }
    },
    {
      "files": ["src/**/*.test.ts"],
      "rules": {
        "vitest/no-conditional-tests": "error",
        "vitest/require-local-test-context-for-concurrent-snapshots": "error"
      }
    }
  ]
}
