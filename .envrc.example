# Copy to .envrc (gitignored) and fill in. Every setting has a local-dev
# default, so none of these are needed to run `make backend` locally.

# export DATABASE_URL=postgres://bbb:bbb@localhost:5435/bbb?sslmode=disable
# Point at a local fixture server to test the poller without hitting pingry.org.
# export BBB_URL=https://www.pingry.org/experience/community-life/bbb
# Contact shown in the User-Agent: "BBBWatch/1.0 (+you@example.org)".
export CONTACT_EMAIL=
# export POLL_INTERVAL=5m
# Slower polling from 11pm to 6am school time; unset to disable.
# export NIGHT_POLL_INTERVAL=30m
# export SCHOOL_TZ=America/New_York
# Comma-separated additions to the built-in signup host patterns.
# export SIGNUP_HOSTS_EXTRA=example-signups.com

# HTTP server. PUBLIC_URL is where users reach the app; locally that's the
# Vite dev server, which proxies /api to LISTEN_ADDR.
# export LISTEN_ADDR=127.0.0.1:8094
# (The deployed unit overrides LISTEN_ADDR, PUBLIC_URL and WEB_DIR; see
# scripts/run-production.)
# export PUBLIC_URL=http://localhost:5173
# Built frontend to serve at "/" (production); unset in development.
# export WEB_DIR=../frontend/dist
# Signs the session cookie; required when PUBLIC_URL is https.
# Generate with: openssl rand -base64 48
export SESSION_SECRET=
# Google OAuth client (Web application). Authorized redirect URI:
# $PUBLIC_URL/api/auth/google/callback
export GOOGLE_CLIENT_ID=
export GOOGLE_CLIENT_SECRET=
# Comma-separated emails that become admins on sign-in and need no invite.
export ADMIN_EMAILS=

# Web Push. Generate a key pair once with `cd backend && go run ./cmd/server
# -gen-vapid`; changing it invalidates every device's subscription. Unset,
# push is off (events are still recorded).
export VAPID_PUBLIC=
export VAPID_PRIVATE=
# Who push services contact about this sender: mailto: or https:. Defaults
# to mailto:$CONTACT_EMAIL, else PUBLIC_URL.
# export VAPID_SUBJECT=mailto:you@example.org
